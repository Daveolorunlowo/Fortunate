// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ── Models ─────────────────────────────────────────────────────────────────

model Order {
  id            String   @id @default(cuid())
  customerName  String
  phone         String
  address       String
  items         String   // JSON string in SQLite
  totalAmount   Float
  status        String   @default("PENDING") // PENDING, PREPARING, COMPLETED, CANCELLED
  paystackRef   String?
  isPaid        Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model Reservation {
  id             String   @id @default(cuid())
  customerName   String
  phone          String
  email          String?
  type           String   // RESTAURANT, LOUNGE
  date           DateTime
  time           String   // e.g. "7:30 PM"
  guests         Int      @default(1)
  specialRequest String?
  status         String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED, COMPLETED
  totalAmount    Float    @default(0)
  paystackRef    String?
  isPaid         Boolean  @default(false)
  experience     String?  // Added this as it was used in actions but might have been missing

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([type])
  @@index([date])
  @@index([status])
  @@map("reservations")
}

model Membership {
  id          String   @id @default(cuid())
  memberName  String
  phone       String
  email       String?
  plan        String   // DAY_PASS, MONTHLY_PRO, VIP_ANNUAL
  isActive    Boolean  @default(true)
  startDate   DateTime @default(now())
  expiryDate  DateTime 
  paystackRef String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([plan])
  @@map("memberships")
}
